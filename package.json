{
	"name": "@health-plus/root",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently \"bun run dev:web\" \"bun run dev:backend\"",
		"dev:web": "cd packages/web-app && bun run dev",
		"dev:backend": "cd packages/backend-express && bun run dev",
		"build": "bun run build:web && bun run build:backend",
		"build:web": "cd packages/web-app && bun run build",
		"build:backend": "cd packages/backend-express && bun run build",
		"clean": "rm -rf **/node_modules **/dist"
	},
	"devDependencies": {
		"typescript": "^5.3.0",
		"bun-types": "latest",
		"concurrently": "^8.2.2"
	},
	"dependencies": {
		"pocketbase": "^0.25.1"
	}
}